{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quire",
  "version": "0.1.0",
  "identifier": "app.quire.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quire",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 28 },
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: quire: http://quire.localhost https://lh3.googleusercontent.com",
        "font-src": "'self' data:",
        "frame-src": "quire: http://quire.localhost",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:8787 wss://cloud.quire.app wss://*.workers.dev"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: quire: http://quire.localhost https://lh3.googleusercontent.com",
        "font-src": "'self' data:",
        "frame-src": "quire: http://quire.localhost",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:8787 wss://cloud.quire.app wss://*.workers.dev"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "View, organise, edit and share HTML",
    "copyright": "Quire contributors · AGPL-3.0",
    "fileAssociations": [
      {
        "ext": ["html", "htm", "xhtml"],
        "name": "HTML Document",
        "description": "HTML document",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "text/html"
      }
    ],
    "macOS": { "minimumSystemVersion": "11.0" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
