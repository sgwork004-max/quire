{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quire-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "DocRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocRoom"] }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "quire-blobs" }],
  "vars": {
    // Free plan: total shared content per owner, in megabytes.
    "QUOTA_MB": "100"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quire",
      // Replaced with the real id by `wrangler d1 create quire` before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
