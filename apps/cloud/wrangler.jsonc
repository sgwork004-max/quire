{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quire-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "DocRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocRoom"] }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "quire-blobs" }],
  "vars": {
    // Free plan: total shared content per owner, in megabytes.
    "QUOTA_MB": "25"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quire",
      // Self-hosting: replace with the id from `wrangler d1 create quire`.
      "database_id": "ceaf5ed6-ca5b-469f-806b-534454baf9d5",
      "migrations_dir": "migrations"
    }
  ]
}
